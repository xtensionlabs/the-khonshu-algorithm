<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>khonshu_planner</name>
  <version>0.1.0</version>
  <description>Khonshu FS-AI path planning package (v0.1 baseline).</description>
